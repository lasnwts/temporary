$bytes = [System.IO.File]::ReadAllBytes("C:\path\to\yourfile.zip")
$hex = ($bytes[0..1] | ForEach-Object { "{0:X2}" -f $_ }) -join " "

if ($hex -eq "1F 8B") {
    Write-Host "Это формат GZIP (сигнатура 1F 8B)" -ForegroundColor Green
} elseif ($hex -eq "50 4B") {
    Write-Host "Это настоящий ZIP-архив (сигнатура 50 4B)" -ForegroundColor Cyan
} else {
    Write-Host "Неизвестный формат. Первые байты: $hex" -ForegroundColor Yellow
}


Чтобы определить, что файл с расширением .zip на самом деле является архивом Gzip (.gz / .gzip), нужно проверить его первые байты (сигнатуру / magic bytes).
У формата Gzip первые два байта в шестнадцатеричном виде — это 1F 8B (в ASCII соответствуют символам \x1f\x8b). У настоящего ZIP-архива первые байты всегда 50 4B 03 04 (PK\x03\x04).

Способ 1: Проверка через PowerShell (самый быстрый)

Откройте PowerShell и выполните следующую команду (замените C:\path\to\yourfile.zip на путь к вашему файлу):
---

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.stream.Stream;

public class FileCounter {
    public static void main(String[] args) {
        Path dir = Paths.get("путь/к/вашему/каталогу");

        // Используем try-with-resources для автоматического закрытия стрима
        try (Stream<Path> stream = Files.find(dir, Integer.MAX_VALUE, 
                (path, attrs) -> attrs.isRegularFile() && !path.toString().endsWith(".zip"))) {
            
            long count = stream.count();
            System.out.println("Количество регулярных файлов (без .zip): " + count);

        } catch (IOException e) {
            System.err.println("Ошибка при обходе каталога: " + e.getMessage());
        }
    }
}
