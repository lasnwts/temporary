package ru.usb.get_trigger_okb_rtm.service.smb;

import jcifs.smb.SmbFile;
import org.apache.tomcat.util.http.fileupload.FileUtils;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.core.io.FileSystemResource;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;
import ru.usb.get_trigger_okb_rtm.config.Config;
import ru.usb.get_trigger_okb_rtm.config.LG;
import ru.usb.get_trigger_okb_rtm.model.smb.SmbFileDtoV2;
import ru.usb.get_trigger_okb_rtm.model.zip.ZipListFile;
import ru.usb.get_trigger_okb_rtm.service.json.TrgJsonReader;
import ru.usb.get_trigger_okb_rtm.service.mail.ServiceMailError;
import ru.usb.get_trigger_okb_rtm.utils.UnzipM;

import java.io.File;
import java.io.IOException;
import java.nio.file.FileSystems;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;
import java.util.Optional;

@Service
public class FlowSmbOperation {

    private final Config config;
    private final SmbService smbService;
    private final ServiceMailError serviceMailError;
    private final UnzipM unzipM;
    private final TrgJsonReader trgJsonReader;

    private static final long MIN_FILE_AGE_MS = 1_800; // 30 секунд

    @Autowired
    public FlowSmbOperation(Config config, SmbService smbService, ServiceMailError serviceMailError,
                            UnzipM unzipM, TrgJsonReader trgJsonReader) {
        this.config = config;
        this.smbService = smbService;
        this.serviceMailError = serviceMailError;
        this.unzipM = unzipM;
        this.trgJsonReader = trgJsonReader;
    }

    Logger logger = LoggerFactory.getLogger(FlowSmbOperation.class);

    private final SimpleDateFormat sdfTime = new SimpleDateFormat("dd.MM.yyyy HH:mm:ss");

    private static final String PREFIX = "TRG_";
    private static final List<String> KEYWORDS = List.of("account", "subject", "request");

    private boolean isMature(SmbFile smbFile) {
        long age = System.currentTimeMillis() - smbFile.getLastModified();
        return age > MIN_FILE_AGE_MS;
    }

    private boolean isTargetJsonFile(File f) {
        String name = f.getName().toLowerCase(Locale.ROOT);
        if (!name.startsWith(PREFIX.toLowerCase(Locale.ROOT)) || !name.endsWith(".json")) {
            return false;
        }
        return KEYWORDS.stream().anyMatch(name::contains);
    }

    /**
     * НОВОЕ: гарантирует существование локальной временной директории.
     * Создаёт её, если отсутствует. Возвращает File директории.
     */
    private File ensureTempDirectory() throws IOException {
        File tempDir = Paths.get(new FileSystemResource("").getFile().getAbsolutePath() +
                FileSystems.getDefault().getSeparator() + config.getNetFileShare()).toFile();

        if (!tempDir.exists()) {
            if (tempDir.mkdirs()) {
                logger.info("{}: Создана временная директория: {}",
                        LG.USBLOGINFO, tempDir.getAbsolutePath());
            } else {
                throw new IOException("Не удалось создать временную директорию: " + tempDir.getAbsolutePath());
            }
        }
        if (!tempDir.canWrite()) {
            throw new IOException("Нет прав на запись во временную директорию: " + tempDir.getAbsolutePath());
        }
        return tempDir;
    }

    @SuppressWarnings("java:S3776")
    public void start() throws IOException, InterruptedException, InvalidFileException {
        logger.debug("{}: start processed...", LG.USBLOGINFO);

        smbService.getCifsConfig();
        Optional<List<SmbFile>> smbFileList;

        if (smbService.checkSmb()) {
            smbFileList = smbService.getSmbFileList(config.getSmbFileUrl());
        } else {
            smbFileList = smbService.getSmbFileList(config.getSmbFileUrl(), smbService.getCifsConfig());
        }

        if (smbFileList.isPresent()) {
            logger.debug("smbFileList.isPresent() = true");
            logger.debug("smbFileList.size() = {}", smbFileList.get().size());

            for (SmbFile smbFile : smbFileList.get()) {
                Thread.sleep(500);

                if (smbFile.isFile()
                        && getExtensionFromStrFileName(smbFile.getName()).equalsIgnoreCase("zip")
                        && isMature(smbFile)) {

                    logger.info("{}: File:обнаружен, передан на анализ:smbFile.getUncPath() = {}",
                            LG.USBLOGINFO, smbFile.getUncPath());

                    // НОВОЕ: гарантируем наличие temporary перед копированием
                    ensureTempDirectory();

                    File file = smbService.copySmbFileToFile(smbFile, smbFile.getName());

                    ZipListFile pathList = unzipM.unzipFileAutoDetect(file);

                    if (pathList.isErrorFlag()) {
                        moveSourceFileToArchiv(smbFile,
                                new SmbFile(config.getSmbFileErr() + smbFile.getName(),
                                        smbService.getCifsConfig()));
                    } else {
                        List<Path> files = pathList.getPathListFile().orElse(null);

                        if (files != null) {
                            logger.info("{}: Распаковка завершена. Количество файлов в архиве: {}",
                                    LG.USBLOGINFO, files.size());

                            files.forEach(path -> logger.info("{}: Распакован файл: {}, размером:{}",
                                    LG.USBLOGINFO, path, path.toFile().length()));

                            List<File> jsonFiles = files.stream()
                                    .map(Path::toFile)
                                    .filter(this::isTargetJsonFile)
                                    .toList();

                            if (jsonFiles.isEmpty()) {
                                logger.warn("{}: Json файлы не найдены в распакованном архиве: {}",
                                        LG.USBLOGERROR, file.getName());
                                cleanTempDirectory();
                                moveSourceFileToArchiv(smbFile,
                                        new SmbFile(config.getSmbFileArc() + smbFile.getName(),
                                                smbService.getCifsConfig()));
                                continue;
                            }

                            final int[] processedCount = {0};
                            final int[] errorCount = {0};
                            final int totalCount = jsonFiles.size();

                            jsonFiles.forEach(jsonFile -> {
                                try {
                                    logger.info("{}: Начинаем обработку JSON файла [{}/{}]: {}",
                                            LG.USBLOGINFO,
                                            processedCount[0] + errorCount[0] + 1,
                                            totalCount,
                                            jsonFile.getAbsolutePath());

                                    trgJsonReader.processingJsonFile(jsonFile.toPath().toFile());

                                    logger.info("{}: JSON файл успешно обработан: {}",
                                            LG.USBLOGINFO, jsonFile.getAbsolutePath());
                                    processedCount[0]++;

                                    if (Files.deleteIfExists(jsonFile.toPath())) {
                                        logger.info("{}: Удален временный JSON файл: {}",
                                                LG.USBLOGINFO, jsonFile.getAbsolutePath());
                                    } else {
                                        logger.warn("{}: Не удалось удалить временный JSON файл: {}",
                                                LG.USBLOGWARNING, jsonFile.getAbsolutePath());
                                    }
                                } catch (IOException e) {
                                    errorCount[0]++;
                                    logger.error("{}: [JSON] файл:{} содержит ошибку: {}",
                                            LG.USBLOGERROR,
                                            jsonFile.getAbsolutePath(),
                                            e.getMessage());
                                    logger.debug("{}: [JSON] Trace, файл:{} содержит ошибку: ",
                                            LG.USBLOGERROR, jsonFile.getName(), e);

                                    serviceMailError.sendMailErrorSubject("Ошибка обработки JSON файла",
                                            "Ошибка при обработке JSON файла." +
                                                    "\n Имя файла: " + jsonFile.getName() + "\n" +
                                                    "\n Архив: " + file.getName() + "\n" +
                                                    "\n Дата : " + formatDateTime(new Date()) + "\n" +
                                                    "\n Сообщение об ошибке: " + e.getMessage());
                                }
                            });

                            cleanTempDirectory();
                        }

                        moveSourceFileToArchiv(smbFile,
                                new SmbFile(config.getSmbFileArc() + smbFile.getName(),
                                        smbService.getCifsConfig()));
                    }
                }
            }
        } else {
            logger.info("smbFileList.isPresent() = false");
        }

        logger.debug("{}: end processed....", LG.USBLOGINFO);
    }

    private void cleanTempDirectory() {
        try {
            File tempDir = Paths.get(new FileSystemResource("").getFile().getAbsolutePath() +
                    FileSystems.getDefault().getSeparator() + config.getNetFileShare()).toFile();
            if (tempDir.exists()) {
                FileUtils.cleanDirectory(tempDir);
                logger.info("{}: Временная директория очищена: {}",
                        LG.USBLOGINFO, tempDir.getAbsolutePath());
            }
        } catch (Exception e) {
            logger.error("{}: Ошибка при очистке временной директории: {}",
                    LG.USBLOGERROR, e.getMessage());
        }
    }

    private void moveSourceFileToArchiv(SmbFile smbFileSource, SmbFile smbFileTarget) {
        checkCopySmbFile(smbService.copySmbFile(smbFileSource, smbFileTarget));
        logger.info("{}:## Обработка файла: {} завершена.",
                LG.USBLOGINFO, smbFileSource.getCanonicalPath());
    }

    private void checkCopySmbFile(SmbFileDtoV2 smbFileDto) {
        Optional<SmbFile> smbFileSource = smbService.getSmbFile(smbFileDto.getFileSource(),
                smbService.getCifsConfig());
        Optional<SmbFile> smbFileDest = smbService.getSmbFile(smbFileDto.getFileDestination(),
                smbService.getCifsConfig());

        if (smbFileSource.isPresent() && smbFileDest.isPresent()) {
            logger.info("{}: Сравниваем файлы:[Источник:{}, Получатель:{}]",
                    LG.USBLOGINFO,
                    smbFileSource.get().getUncPath(),
                    smbFileDest.get().getUncPath());
            if (smbService.compareSmbFile(smbFileSource.get(), smbFileDest.get())) {
                logger.info("{}: Попытка удаление файла:{}",
                        LG.USBLOGINFO, smbFileDto.getFileSource());
                if (smbService.deleteSmbFile(smbFileSource.get())) {
                    logger.info("{}:: Файл:{} удален после обработки.",
                            LG.USBLOGINFO, smbFileSource.get().getCanonicalPath());
                } else {
                    logger.warn("{}: Файл:{} не удален",
                            LG.USBLOGWARNING, smbFileSource.get().getCanonicalPath());
                    serviceMailError.sendMailErrorSubject(
                            "Ошибка при обработке файла триггеров РТМ. Сервис:get-trigger-okb-rtm",
                            "Не удалось удалить файл:" + getWrapNull(smbFileSource.get().getCanonicalPath()));
                }
            }
        }
    }

    public String getWrapNull(String line) {
        if (line == null) {
            return "";
        } else {
            return line.trim();
        }
    }

    public String getExtensionFromFile(File fileName) {
        String ext = StringUtils.getFilenameExtension(fileName.getName());
        if (ext == null) {
            ext = "";
        }
        return ext;
    }

    public String getExtensionFromStrFileName(String fileName) {
        return StringUtils.getFilenameExtension(new File(fileName).getName());
    }

    public String formatDateTime(Date date) {
        return sdfTime.format(date);
    }
}
